---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';
import { count } from '../lib/plural';

const recipes = await getCollection('recipes');
const pantry = await getCollection('pantry');
const parts = await getCollection('parts');

const FEATURED = ['sy21219'];
const featured = FEATURED.map((id) => recipes.find((r) => r.id === id)).filter((r) => r !== undefined);

const brandCounts = new Map<string, number>();
for (const p of pantry) brandCounts.set(p.data.brand, (brandCounts.get(p.data.brand) ?? 0) + 1);
const brands = [...brandCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<StarlightPage
  frontmatter={{
    title: 'Circuit Dessert',
    description: 'Reference designs, plated like recipes. An open repository of fun circuits and reference designs from across the industry.',
    template: 'splash',
    tableOfContents: false,
  }}
>
  <section class="cd-home-hero">
    <h1>Reference designs, <em>plated like recipes.</em></h1>
    <p class="cd-lede">
      Circuit Dessert is an open repository of fun circuits and reference designs from across the industry.
      Every design is credited to its maker, laid out like a recipe, and linked back to the original source.
    </p>
    <p class="cd-actions">
      <a class="cd-btn is-primary" href={url('recipes/')}>Browse the Recipe Book</a>
      <a class="cd-btn" href={url('contribute/')}>Contribute a design</a>
    </p>
  </section>

  <section class="cd-group">
    <h2>A cookbook for circuits.</h2>
    <p>
      Datasheets tell you what a part can do. Reference designs show you how to use it. Circuit Dessert gathers
      reference designs from many manufacturers, credits each one to its maker, and plates the best as recipes:
      the parts list as ingredients, the features as the method.
    </p>
  </section>

  <section class="cd-group">
    <h2>Featured designs</h2>
    <div class="cd-grid">
      {featured.map((r) => (
        <div class="cd-card">
          <span class="tag">{r.data.category}</span>
          <h3><a href={url(`recipes/${r.id}/`)}>{r.data.design_id ? `${r.data.design_id}: ` : ''}{r.data.title}</a></h3>
          <p class="spec">{r.data.summary}</p>
        </div>
      ))}
      <div class="cd-card">
        <span class="tag">The Pantry</span>
        <h3><a href={url('pantry/')}>{count(pantry.length, 'reference design')} in the Pantry</a></h3>
        <p class="spec">Grouped by brand, shown as published, and linked to their sources.</p>
      </div>
      <div class="cd-card">
        <span class="tag">Parts</span>
        <h3><a href={url('parts/')}>{count(parts.length, 'part')}, checked against datasheets</a></h3>
        <p class="spec">Specs verified against the manufacturer's datasheet, with our own notes on using them.</p>
      </div>
    </div>
  </section>

  <section class="cd-group">
    <h2>Designs from the kitchens of</h2>
    <p class="cd-chip-row">
      {brands.map(([name]) => <span class="cd-chip">{name}</span>)}
    </p>
  </section>

  <section class="cd-group cd-cta">
    <h2>Got a circuit worth plating?</h2>
    <p>Open to hobbyists, students, and working engineers.</p>
    <p><a class="cd-btn is-primary" href={url('contribute/')}>Contribute a design</a></p>
  </section>
</StarlightPage>
