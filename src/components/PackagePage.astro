---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { render } from 'astro:content';
import { buildToc, type Sec } from '../lib/doc';
import { footprintUrl, partsUsing } from '../lib/packages';
import { partUrl } from '../lib/parts';
import { url } from '../lib/url';

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings: bodyHeadings } = await render(entry);
const users = await partsUsing(entry);
const checked = new Set(d.checked_against.map((s: string) => s.toLowerCase()));
const assumed = new Set(d.assumed_for.map((s: string) => s.toLowerCase()));

// The illustration is generated by `npm run kicad` from the same data as the footprint.
const svgs = import.meta.glob('../assets/packages/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const svg = svgs[`../assets/packages/${entry.id}.svg`];

const pre: Sec[] = [{ id: 'overview', title: 'Overview' }];
const post: Sec[] = [];
if (d.footprint) post.push({ id: 'kicad-footprint', title: 'KiCad footprint' });
post.push({ id: 'parts', title: 'Parts that list this package' });
const headings = buildToc(pre, bodyHeadings.filter((h: { depth: number }) => h.depth <= 3), post);
---

<StarlightPage
  frontmatter={{ title: d.name, description: d.summary, tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 3 } }}
  headings={headings}
>
  <div class="cd-doc">
    <div class="cd-chip-row">
      <span class="cd-chip is-gold">Package</span>
      {d.footprint && (d.opened_in_kicad ? <span class="cd-chip is-ok">Footprint opened in KiCad</span> : <span class="cd-chip is-draft">Footprint not yet opened in KiCad</span>)}
      {d.draft && <span class="cd-chip is-draft">Draft notes</span>}
    </div>
    <p class="cd-lede">{d.summary}</p>

    <section class="cd-section">
      <h2 id="overview">Overview</h2>
      {svg && <figure class="cd-package-fig" set:html={svg + `<figcaption class="cd-caption">Generated from the dimensions below, in mm. Package outline and pad layout: ${d.source.part} datasheet, ${d.source.revision}, page ${d.source.page}. Body size shown at the midpoint of the datasheet's range.</figcaption>`} />}
      <div class="cd-table-wrap">
        <table class="cd-table cd-kv"><tbody>
          {d.dimensions.map((i: { label: string; value: string }) => <tr><th scope="row">{i.label}</th><td>{i.value}</td></tr>)}
        </tbody></table>
      </div>
    </section>

    <Content />

    {d.footprint && (
      <section class="cd-section">
        <h2 id="kicad-footprint">KiCad footprint</h2>
        <div class="cd-table-wrap">
          <table class="cd-table cd-kv"><tbody>
            <tr><th scope="row">File</th><td><a class="cd-link" href={footprintUrl(d.footprint)} download>{d.footprint}</a> · library <code>circuitdessert.pretty</code>, footprint name <code>{d.name}</code></td></tr>
            <tr><th scope="row">Made from</th><td><a class="cd-link" href={d.source.datasheet} target="_blank" rel="noopener noreferrer">{d.source.part} datasheet ↗</a> · {d.source.revision}, page {d.source.page}</td></tr>
            <tr><th scope="row">File format</th><td>KiCad 7 format (opens in KiCad 7, 8 and 9)</td></tr>
          </tbody></table>
        </div>
        {!d.opened_in_kicad && (
          <p class="cd-note is-warn"><strong>Not yet opened in KiCad.</strong> The file was generated by script from the datasheet dimensions and checked against them, but it has not been loaded in KiCad yet. Print it at 1:1 and compare it with a real part before ordering boards.</p>
        )}
      </section>
    )}

    <section class="cd-section">
      <h2 id="parts">Parts that list this package</h2>
      {users.length === 0 ? <p>No part on the site lists this package yet.</p> : (
        <>
          <div class="cd-table-wrap">
            <table class="cd-table">
              <thead><tr><th>Part</th><th>Maker</th><th>Drawing compared with this page</th></tr></thead>
              <tbody>
                {users.map((p) => (
                  <tr>
                    <td><a href={partUrl(p.data)}>{p.data.part}</a></td>
                    <td>{p.data.manufacturer}</td>
                    <td>{checked.has(p.data.part.toLowerCase()) ? 'Yes' : assumed.has(p.data.part.toLowerCase()) ? `Assumed: compatible with ${d.source.part}` : 'Not yet'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p>A part marked "Not yet" or "Assumed" names this package, but its own datasheet drawing has not been compared with this page, so check it before using the footprint.</p>
        </>
      )}
    </section>

    <p style="margin-top:1.5rem"><a href={url('packages/')}>← All packages</a></p>
  </div>
</StarlightPage>
